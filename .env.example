# Copy to .env and adjust. Relative paths resolve against the project root.
# .env is git-ignored; never commit real values.

# Source workbook (bilateral, one row per patient). Contains identifiable data: keep it out of git.
HAND_INJURY_WORKBOOK_PATH=data/Version 2- MIT calculation table.xlsx

# Data dictionary workbook with a "Data Dictionary" sheet (column_name, layer, data_type, allowed_values_range).
HAND_INJURY_DATA_DICTIONARY_PATH=data/Data_Dictionary_v3.xlsx

# Where generated artefacts are written.
HAND_INJURY_OUTPUT_DIR=outputs
HAND_INJURY_REPORTS_DIR=reports

# Optional: curated feature list (CSV with a feature_name column) to use for Task B instead of
# the Task A shortlist.
HAND_INJURY_FEATURE_LIST_PATH=

# Optional secret used to pseudonymise hospital IDs (HMAC-SHA256). With it set, the data
# custodian can re-link output rows to source records; without it, sequential P0001-style
# codes are used. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
HAND_INJURY_PATIENT_ID_SALT=
